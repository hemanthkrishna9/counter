<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".MainActivity">

    <!-- ===== SCROLLABLE CONTENT (padded so nothing hides under the bottom bar) ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="220dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="40dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_centerInParent="true">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="1dp"
                        android:background="#60D4AF37"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="22sp"
                        android:textColor="@color/gold_light"
                        android:letterSpacing="0.2"
                        android:fontFamily="serif" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="1dp"
                        android:background="#60D4AF37"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnReminder"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_bell_gold"
                    android:padding="8dp"
                    android:background="@drawable/bg_action_button"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/set_reminder"
                    android:alpha="0.8"/>

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/om_symbol"
                android:textSize="20sp"
                android:textColor="@color/saffron"
                android:layout_marginBottom="20dp" />

            <!-- DEITY IMAGE — compact 130dp -->
            <FrameLayout
                android:layout_width="146dp"
                android:layout_height="146dp"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="146dp"
                    android:layout_height="146dp"
                    android:background="@drawable/bg_deity_outer_ring"
                    android:layout_gravity="center" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardImage"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="66dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/gold"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/bg_mid">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivGoddess"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="@string/deity_image_desc"/>

                        <LinearLayout
                            android:id="@+id/layoutUploadHint"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_camera_gold"
                                android:alpha="0.7"
                                android:contentDescription="@null"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/upload_deity"
                                android:textAlignment="center"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:layout_marginTop="6dp"/>

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Photo action buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_photo"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_action_button"
                    android:clickable="true"
                    android:focusable="true"/>

                <View android:layout_width="12dp" android:layout_height="1dp" />

                <TextView
                    android:id="@+id/btnClearImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remove_photo"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_action_button"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- STATS ROW: Total | Streak | Malas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_label"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/tvTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/gold_light"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_fire"
                            android:contentDescription="@null"
                            android:layout_marginEnd="3dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/streak_label"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.12" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStreakDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/saffron_light"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/days_label"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mala_label"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/tvMalaCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/gold"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                </LinearLayout>

            </LinearLayout>

            <!-- MALA PROGRESS RING + COUNT (centrepiece) -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp">

                <com.mantracounter.app.MalaProgressView
                    android:id="@+id/malaProgressView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/count_label"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.2" />

                    <TextView
                        android:id="@+id/tvCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:id="@+id/tvMalaProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 108"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===== FIXED BOTTOM BAR — always visible ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:elevation="12dp">

        <!-- Chant button + flanking action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Undo -1 -->
            <LinearLayout
                android:id="@+id/btnMinusOne"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/minus_one"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/undo_label"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- Spacer -->
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <!-- Main OM chant button with pulse ring -->
            <FrameLayout
                android:layout_width="152dp"
                android:layout_height="152dp">

                <View
                    android:id="@+id/viewPulseRing"
                    android:layout_width="152dp"
                    android:layout_height="152dp"
                    android:background="@drawable/bg_pulse_ring"
                    android:layout_gravity="center"
                    android:alpha="0.5" />

                <FrameLayout
                    android:id="@+id/btnCount"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_gold"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#2384;"
                            android:textSize="44sp"
                            android:textColor="#0D0500"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tap_to_chant"
                            android:textSize="10sp"
                            android:textColor="#661A0800"
                            android:letterSpacing="0.05"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </FrameLayout>

            </FrameLayout>

            <!-- Spacer -->
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <!-- Reset -->
            <LinearLayout
                android:id="@+id/btnReset"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh_gold"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
